<mxfile host="app.diagrams.net">
  <diagram name="QorFinder Architecture" id="qorfinder-architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Section titles -->
        <mxCell id="title-index" value="Indexing path" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="title-query" value="Query path" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="300" height="30" as="geometry" />
        </mxCell>

        <!-- Indexing path nodes -->
        <mxCell id="fs" value="File System" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="parser" value="Parser&#10;(txt / md / pdf / docx)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="60" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="chunker" value="Chunker&#10;(fixed window + overlap)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="60" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="embedder-idx" value="Embedder&#10;(fastembed ONNX, e5-small,&#10;&quot;passage: &quot; prefix)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="60" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lexical-store" value="Lexical Store&#10;(tantivy, BM25 inverted index)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="880" y="20" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="vector-store" value="Vector Store&#10;(usearch, HNSW, cosine)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="880" y="100" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fingerprint-store" value="Fingerprint Store&#10;(redb: mtime, size,&#10;chunk_count, vector_keys per file)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="640" y="200" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="fs" target="parser"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="parser" target="chunker"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="chunker" target="embedder-idx"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="vector" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="embedder-idx" target="vector-store"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="text + metadata" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="embedder-idx" target="lexical-store"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="commit() records fingerprint&#10;+ vector_keys, once per scan" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="vector-store" target="fingerprint-store"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="lexical-store" target="fingerprint-store"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="mtime/size unchanged?&#10;skip re-embedding" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="fingerprint-store" target="fs"><mxGeometry relative="1" as="geometry">
          <Array as="points"><mxPoint x="740" y="330" /><mxPoint x="115" y="330" /></Array>
        </mxGeometry></mxCell>

        <!-- Query path nodes -->
        <mxCell id="cli-query" value="CLI: query &lt;text&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="embedder-q" value="Embedder&#10;(&quot;query: &quot; prefix)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="400" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="vector-search" value="search_vector()&#10;top-k by cosine distance" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="360" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lexical-search" value="search_lexical()&#10;top-k by BM25 score" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="450" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rrf" value="Reciprocal Rank Fusion&#10;score = &#931; 1 / (60 + rank + 1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="660" y="400" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="results" value="Ranked results&#10;(file path, chunk, snippet)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="900" y="400" width="170" height="60" as="geometry" />
        </mxCell>

        <mxCell id="q1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="cli-query" target="embedder-q"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="embedder-q" target="vector-search"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q3" value="raw text&#10;(no embedding needed)" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="cli-query" target="lexical-search"><mxGeometry relative="1" as="geometry">
          <Array as="points"><mxPoint x="115" y="480" /></Array>
        </mxGeometry></mxCell>
        <mxCell id="q4" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="vector-store" target="vector-search"><mxGeometry relative="1" as="geometry">
          <Array as="points"><mxPoint x="1010" y="130" /><mxPoint x="1010" y="390" /></Array>
        </mxGeometry></mxCell>
        <mxCell id="q5" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="lexical-store" target="lexical-search"><mxGeometry relative="1" as="geometry">
          <Array as="points"><mxPoint x="1150" y="50" /><mxPoint x="1150" y="480" /></Array>
        </mxGeometry></mxCell>
        <mxCell id="q6" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="vector-search" target="rrf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q7" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="lexical-search" target="rrf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q8" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="rrf" target="results"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Descriptions -->
        <mxCell id="desc-title" value="Component descriptions" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="Parser: extracts raw text per file type (txt/md read directly, PDF via lopdf, DOCX via docx-rs).&#10;&#10;Chunker: splits text into overlapping fixed-size windows (default 512 chars, 64 overlap), whitespace-collapsed.&#10;&#10;Embedder: wraps a local ONNX sentence-embedding model (multilingual-e5-small, 384 dims) via fastembed; the SAME model embeds both passages and queries, with e5's required &quot;passage: &quot;/&quot;query: &quot; prefixes — this is a hard invariant, changing models requires re-indexing.&#10;&#10;Lexical Store (tantivy): one document per chunk, storing chunk_id, file_path, chunk_index, text, and fingerprint fields. Unstemmed tokenizer, since content may be non-English. BM25-ranked search over the text field.&#10;&#10;Vector Store (usearch): an embedded HNSW approximate-nearest-neighbor index keyed by a u64 derived from sha2(&quot;path:chunk_index&quot;). Holds only vector geometry; every hit is resolved back to text via the Lexical Store.&#10;&#10;Fingerprint Store (redb): the only component that knows, per file, its (mtime, size), chunk count, and the vector keys its chunks map to. This makes incremental re-indexing an O(files) lookup instead of a full-index scan, and is what lets the indexer skip files that have not changed.&#10;&#10;Query fusion: dense and lexical results are retrieved independently (top max(top_k*4, 50) each) and combined by Reciprocal Rank Fusion, so a chunk ranking well on either side contributes and one ranking well on both is boosted." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="1020" height="420" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
