<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>QorFinder third-party licences</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 960px; margin: 0 auto; padding: 16px; }
    pre { white-space: pre-wrap; background: #f4f4f4; padding: 12px; }
  </style>
</head>
<body>
  <h1>Third-party licences</h1>
  <p>QorFinder is built with the following Rust libraries. Their licences ask for these notices to travel with copies of the program.</p>
  <h2>Overview</h2>
  <ul>
    {{#each overview}}<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
    {{/each}}
  </ul>
  <h2>Licence texts</h2>
  {{#each licenses}}
  <section>
    <h3 id="{{id}}">{{name}}</h3>
    <p>Used by:</p>
    <ul>
      {{#each used_by}}<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  </section>
  {{/each}}
</body>
</html>
